# Copie para .env e ajuste. NUNCA versione o .env nem senhas reais aqui.

NODE_ENV=development
PORT=5000
APP_NAME=Projeto Profissional
APP_BASE_URL=http://localhost:5000

MONGO_URI=mongodb://localhost:27017/app_db

# Obrigatorio em producao (min. 32 caracteres).
# Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=2h

# true quando servir por HTTPS. Em HTTP puro precisa ficar false,
# senao o navegador descarta o cookie e a sessao nunca cola.
COOKIE_SECURE=false

# Origens extras liberadas no CORS de /api, separadas por virgula.
CORS_ALLOWED_ORIGINS=

# Admin inicial (criado no 1o boot se nao houver nenhum admin).
# Deixe ADMIN_PASSWORD vazio para o servidor gerar uma senha aleatoria
# e imprimi-la UMA unica vez no log de boot.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrador
ADMIN_PASSWORD=
