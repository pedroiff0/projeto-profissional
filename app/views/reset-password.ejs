<%- include('partials/header', { title: 'Redefinir senha' }) %>
<section class="card auth-card">
  <h1>Redefinir senha</h1>
  <div id="error" class="alert alert-error" hidden></div>
  <div id="ok" class="alert alert-ok" hidden></div>
  <form id="form-reset" novalidate>
    <input id="token" type="hidden" value="<%= token %>" />
    <label class="field">
      <span>Nova senha</span>
      <input id="newPassword" type="password" autocomplete="new-password" required />
    </label>
    <p class="muted small">Mínimo 12 caracteres, com maiúscula, minúscula e número.</p>
    <button type="submit" class="btn-primary btn-block">Redefinir</button>
  </form>
</section>
<%- include('partials/footer', { pageScript: 'reset-password' }) %>
