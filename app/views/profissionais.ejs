<%- include('partials/header', { title: 'Profissionais' }) %>
<section class="card" data-api-base="<%= apiBase %>">
  <h1>Profissionais</h1>
  <p class="muted"><%= t('pro.desc') %></p>
  <form id="pro-form" class="cad-form" autocomplete="off">
    <div class="field">
      <span><%= t('pro.name') %></span>
      <input type="text" name="nome" maxlength="120" required />
    </div>
    <div class="row" style="align-items:flex-end;">
      <div class="field" style="flex:1;">
        <span><%= t('pro.func') %></span>
        <input type="text" name="funcao" maxlength="80" />
      </div>
      <div class="field" style="flex:1;">
        <span><%= t('pro.contact') %></span>
        <input type="text" name="contato" maxlength="160" />
      </div>
      <div class="field" style="flex:1;">
        <span>E-mail</span>
        <input type="email" name="email" maxlength="160" required />
      </div>
    </div>
    <div class="row">
      <button class="btn-primary" type="submit"><%= t('pro.add') %></button>
      <span id="pro-status" class="muted small" aria-live="polite"></span>
    </div>
  </form>
</section>
<section class="card">
  <h2><%= t('pro.list') %></h2>
  <table class="dom-table" id="pro-table">
    <thead>
      <tr>
        <th style="width:26%">Nome</th>
        <th>Função</th>
        <th>Contato</th>
        <th>E-mail</th>
        <th style="width:96px; text-align:right">Ações</th>
      </tr>
    </thead>
    <tbody id="pro-rows"></tbody>
  </table>
  <p id="pro-empty" class="dom-empty" hidden>Nenhum profissional ainda.</p>
</section>

<div id="pro-modal" class="modal" hidden>
  <div class="modal-backdrop" data-close="1"></div>
  <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="pro-modal-title">
    <header class="modal-head">
      <h2 id="pro-modal-title" style="margin:0;font-size:1.15rem"><%= t('pro.name') %></h2>
      <button class="modal-x" type="button" data-close="1" aria-label="Fechar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </header>
    <form id="pro-edit-form" class="cad-form" autocomplete="off" style="padding:1.2rem 1.3rem;">
      <div class="field"><span><%= t('pro.name') %></span><input type="text" name="nome" maxlength="120" required /></div>
      <div class="field"><span><%= t('pro.func') %></span><input type="text" name="funcao" maxlength="80" /></div>
      <div class="field"><span><%= t('pro.contact') %></span><input type="text" name="contato" maxlength="160" /></div>
      <div class="field"><span>E-mail</span><input type="email" name="email" maxlength="160" required /></div>
      <div class="row">
        <button class="btn-primary" type="submit"><%= t('board.save') %></button>
        <button class="btn-outline" type="button" data-close="1"><%= t('board.cancel') %></button>
        <span id="pro-edit-status" class="muted small" aria-live="polite"></span>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
