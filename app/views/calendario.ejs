<%- include('partials/header', { title: t('nav.calendar') }) %>
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="h3 mb-0"><%= t('nav.calendar') %></h1>
    <div class="cal-nav">
      <button id="prev" class="btn btn-outline-secondary btn-sm" type="button" aria-label="<%= t('task.moveLeft') %>">←</button>
      <span id="month-label" class="month-label"></span>
      <button id="next" class="btn btn-outline-secondary btn-sm" type="button" aria-label="<%= t('task.moveRight') %>">→</button>
    </div>
  </div>

  <section class="calendar" id="calendar" data-api-base="<%= apiBase %>" aria-live="polite">
    <div class="cal-grid cal-weekdays">
      <span>Dom</span><span>Seg</span><span>Ter</span><span>Qua</span><span>Qui</span><span>Sex</span><span>Sáb</span>
    </div>
    <div class="cal-grid" id="cal-body"></div>
  </section>

  <p id="cal-status" class="text-muted small mt-2" aria-live="polite"></p>
</div>
<%- include('partials/footer') %>
