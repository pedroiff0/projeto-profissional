<%- include('partials/header', { title: 'Bem-vindo' }) %>
<section class="card">
  <h1><%= appName %></h1>
  <p class="muted">Escolha um ambiente. Cada um usa um banco de dados separado.</p>
  <div class="row" style="margin-top:1rem; flex-wrap:wrap; gap:1rem">
    <% bancos.forEach(function(b) { %>
      <a class="<%= b.classe %>" href="<%= b.href %>" style="flex:1 1 200px; text-align:center; padding:1rem">
        <strong><%= b.titulo %></strong><br>
        <span class="muted small"><%= b.desc %></span>
      </a>
    <% }); %>
  </div>
</section>
<%- include('partials/footer') %>
