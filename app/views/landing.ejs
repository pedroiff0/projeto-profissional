<%- include('partials/header', { title: t('landing.title') }) %>
<main class="container">
  <section class="hero landing">
    <span class="eyebrow"><%= t('landing.eyebrow') %></span>
    <h1><%= t('landing.headline') %></h1>
    <p class="lede"><%= t('landing.intro') %></p>
  </section>

  <section class="card">
    <h2><%= t('landing.choose') %></h2>
    <p class="muted"><%= t('landing.isolated') %></p>
    <div class="row env-grid">
      <% bancos.forEach(function(b) { %>
        <article class="env-card <%= b.classe %>">
          <header class="env-head">
            <h3><%= b.titulo %></h3>
            <span class="env-badge"><%= b.badge %></span>
          </header>
          <p class="muted small"><%= b.desc %></p>
          <a class="btn-primary btn-block" href="<%= b.href %>"><%= b.cta %></a>
        </article>
      <% }); %>
    </div>
  </section>

  <section class="card card-note">
    <h2><%= t('landing.aboutDemo') %></h2>
    <p><%= t('landing.demoNote') %></p>
  </section>
</main>
<%- include('partials/footer') %>
