<%- include('partials/header', { title: t('landing.title') }) %>
<main class="container">
  <section class="hero landing">
    <span class="eyebrow"><%= t('landing.eyebrow') %></span>
    <h1><%= t('landing.headline') %></h1>
    <p class="lede"><%= t('landing.intro') %></p>
    <div class="landing-cta">
      <a class="btn-primary btn-lg" href="/login"><%= t('landing.cta') %></a>
    </div>
  </section>

  <section class="card">
    <h2><%= t('landing.featuresTitle') %></h2>
    <div class="row features">
      <article class="feature">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 4v5M16 4v5"/></svg>
        <h3><%= t('landing.f1title') %></h3>
        <p class="muted small"><%= t('landing.f1body') %></p>
      </article>
      <article class="feature">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
        <h3><%= t('landing.f2title') %></h3>
        <p class="muted small"><%= t('landing.f2body') %></p>
      </article>
      <article class="feature">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
        <h3><%= t('landing.f3title') %></h3>
        <p class="muted small"><%= t('landing.f3body') %></p>
      </article>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
