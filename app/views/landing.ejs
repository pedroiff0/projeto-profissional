<%- include('partials/header', { title: t('landing.title') }) %>
<main>
  <section class="hero-landing">
    <div class="container">
      <span class="eyebrow"><%= t('landing.eyebrow') %></span>
      <h1 class="display-3 fw-bold"><%= t('landing.headline') %></h1>
      <p class="lead"><%= t('landing.intro') %></p>
      <div class="hero-cta">
        <a class="btn btn-primary btn-lg" href="/login"><%= t('landing.cta') %></a>
        <a class="btn btn-outline-secondary btn-lg" href="/demo/start"><%= t('landing.demoCta') %></a>
      </div>
    </div>
  </section>

  <section class="container py-5">
    <div class="row g-4">
      <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
          <div class="card-body text-center">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--pp-primary)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="mb-3"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 4v5M16 4v5"/></svg>
            <h3 class="h5"><%= t('landing.f1title') %></h3>
            <p class="text-muted small mb-0"><%= t('landing.f1body') %></p>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
          <div class="card-body text-center">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--pp-primary)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="mb-3"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
            <h3 class="h5"><%= t('landing.f2title') %></h3>
            <p class="text-muted small mb-0"><%= t('landing.f2body') %></p>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
          <div class="card-body text-center">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--pp-primary)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="mb-3"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
            <h3 class="h5"><%= t('landing.f3title') %></h3>
            <p class="text-muted small mb-0"><%= t('landing.f3body') %></p>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
