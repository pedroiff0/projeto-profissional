<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'pt' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'Projeto Profissional' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css" />
  <link rel="stylesheet" href="/css/theme-space.css" />
  <link rel="stylesheet" href="/css/main.css" />
</head>
<body>
  <canvas id="galaxies" aria-hidden="true"></canvas>
  <canvas id="constel" aria-hidden="true"></canvas>
  <canvas id="starfield" aria-hidden="true"></canvas>
  <div class="nebula nebula--1" aria-hidden="true"></div>
  <div class="nebula nebula--2" aria-hidden="true"></div>
  <div class="bg-veil" aria-hidden="true"></div>

  <header class="pp-nav" id="ppNav">
    <a class="pp-brand" href="/">
      <span class="pp-logo" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="28" height="28"><circle cx="16" cy="16" r="6" fill="url(#g1)"/><ellipse cx="16" cy="16" rx="14" ry="5.5" fill="none" stroke="url(#g1)" stroke-width="1.4" transform="rotate(-25 16 16)"/><defs><linearGradient id="g1" x1="0" y1="0" x2="32" y2="32"><stop stop-color="#6ea8fe"/><stop offset="1" stop-color="#b692ff"/></linearGradient></defs></svg>
      </span>
      <span>Projeto<strong>Profissional</strong></span>
    </a>
    <nav class="pp-links" aria-label="Navegação principal">
      <% if (typeof user !== 'undefined' && user) { %>
        <% var mp = (typeof modo !== 'undefined' && modo && modo !== 'production') ? '/' + modo : ''; %>
        <a href="<%= mp %>/board"><%= t('nav.board') %></a>
        <a href="<%= mp %>/calendario"><%= t('nav.calendar') %></a>
        <% if (user.role === 'admin') { %><a href="<%= mp %>/admin"><%= t('nav.users') %></a><% } %>
        <a href="<%= mp %>/perfil"><%= t('nav.profile') %></a>
        <a href="/login?logout=1" class="pp-cta"><%= t('nav.logout') %></a>
      <% } else { %>
        <a href="/login" class="pp-cta"><%= t('nav.enter') %></a>
      <% } %>
    </nav>
    <div class="d-flex align-items-center gap-2">
      <div class="lang-switch" role="group" aria-label="<%= t('lang.label') %>">
        <button class="lang-btn" data-lang="pt" aria-label="Português (Brasil)">
          <svg class="flag" viewBox="0 0 20 14"><rect width="20" height="14" fill="#009b3a"/><path d="M10 2.2 17.6 7 10 11.8 2.4 7z" fill="#ffdf00"/><circle cx="10" cy="7" r="2.4" fill="#002777"/><path d="M8.4 6.4a2.4 2.4 0 0 1 3.2 0" fill="none" stroke="#fff" stroke-width=".4"/></svg>
        </button>
        <button class="lang-btn" data-lang="en" aria-label="English">
          <svg class="flag" viewBox="0 0 20 14"><rect width="20" height="14" fill="#fff"/><g fill="#b22234"><rect width="20" height="1.4"/><rect y="2.8" width="20" height="1.4"/><rect y="5.6" width="20" height="1.4"/><rect y="8.4" width="20" height="1.4"/><rect y="11.2" width="20" height="1.4"/></g><rect width="8" height="7.6" fill="#3c3b6e"/></svg>
        </button>
        <button class="lang-btn" data-lang="es" aria-label="Español">
          <svg class="flag" viewBox="0 0 20 14"><rect width="20" height="14" fill="#aa151b"/><rect y="3.5" width="20" height="7" fill="#f1bf00"/><rect y="0" width="20" height="3.5" fill="#aa151b"/><rect y="10.5" width="20" height="3.5" fill="#aa151b"/></svg>
        </button>
        <button class="lang-btn" data-lang="fr" aria-label="Français">
          <svg class="flag" viewBox="0 0 20 14"><rect width="6.6" height="14" fill="#0055A4"/><rect x="6.6" width="6.8" height="14" fill="#fff"/><rect x="13.4" width="6.6" height="14" fill="#EF4135"/></svg>
        </button>
      </div>
      <button id="theme-toggle" class="pp-theme-toggle" aria-label="<%= t('theme.toDark') %>" aria-pressed="false">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
      </button>
    </div>
  </header>
  <main>
