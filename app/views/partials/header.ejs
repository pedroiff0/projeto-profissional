<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'pt' %>"<%= (typeof lp !== 'undefined' && lp) ? ' data-theme="' + ((typeof lpDark !== 'undefined' && lpDark) ? 'dark' : 'light') + '"' : '' %>>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'Projeto Profissional' %></title>
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Quadro de tarefas para organizar o que você tem a fazer: projetos, profissionais, painel de desempenho e foco Pomodoro. Experimente a demonstração.' %>" />
  <link rel="stylesheet" href="/css/main.css" />
</head>
<body id="topo" class="<%= (typeof lp !== 'undefined' && lp) ? 'lp-page lp-light' : '' %>">
<%
  const rota = typeof currentPath !== 'undefined' ? currentPath : '';
  const ativo = (p) => (rota === p ? ' class="is-active" aria-current="page"' : '');
  const logado = typeof user !== 'undefined' && user;
  // modo/base vem de res.locals (selectDb): 'app' -> '', 'demo' -> '/demo'.
  const _modo = (typeof modo !== 'undefined' && modo) || (rota.startsWith('/demo') ? 'demo' : rota.startsWith('/test') ? 'test' : 'app');
  const _base = (typeof base !== 'undefined' && base) || (_modo === 'app' ? '' : '/' + _modo);
%>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="<%= logado ? (_base || '/') : '/' %>">
      <svg class="brand-mark" width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="2.5" y="6" width="19" height="13" rx="2.5" stroke="currentColor" stroke-width="1.8"/>
        <path d="M2.5 10.5h19" stroke="currentColor" stroke-width="1.8"/>
        <circle cx="17" cy="14.5" r="1.4" fill="currentColor"/>
      </svg>
      <span>Projeto Profissional</span>
    </a>

    <% if (logado) { %>
      <nav class="nav-main" aria-label="<%= t('nav.label') || 'Navegação principal' %>">
        <a href="<%= _base || '/' %>"<%- ativo(_base || '/') %>><%= t('nav.tasks') %></a>
        <a href="<%= _base %>/painel"<%- ativo(_base + '/painel') %>><%= t('nav.dash') %></a>
        <a href="<%= _base %>/projetos"<%- ativo(_base + '/projetos') %>><%= t('nav.projects') %></a>
        <a href="<%= _base %>/profissionais"<%- ativo(_base + '/profissionais') %>><%= t('nav.pros') %></a>
        <% if (user.role === 'admin') { %><a href="<%= _base %>/admin"<%- ativo(_base + '/admin') %>><%= t('nav.users') %></a><% } %>
        <a href="<%= _base %>/perfil"<%- ativo(_base + '/perfil') %>><%= t('nav.profile') %></a>
      </nav>
    <% } %>

    <div class="nav-user" style="margin-left:auto; display:flex; align-items:center; gap:0.5rem;">
      <div class="lang-switch" role="group" aria-label="<%= t('lang.label') %>">
        <button class="lang-btn" data-lang="pt" aria-label="Português (Brasil)" aria-pressed="<%= (typeof lang !== 'undefined' && lang === 'pt') ? 'true' : 'false' %>">
          <svg class="flag" viewBox="0 0 20 14"><rect width="20" height="14" fill="#009b3a"/><path d="M10 2.2 17.6 7 10 11.8 2.4 7z" fill="#ffdf00"/><circle cx="10" cy="7" r="2.4" fill="#002777"/><path d="M8.4 6.4a2.4 2.4 0 0 1 3.2 0" fill="none" stroke="#fff" stroke-width=".4"/></svg>
        </button>
        <button class="lang-btn" data-lang="en" aria-label="English" aria-pressed="<%= (typeof lang !== 'undefined' && lang === 'en') ? 'true' : 'false' %>">
          <svg class="flag" viewBox="0 0 20 14"><rect width="20" height="14" fill="#fff"/><g fill="#b22234"><rect width="20" height="1.4"/><rect y="2.8" width="20" height="1.4"/><rect y="5.6" width="20" height="1.4"/><rect y="8.4" width="20" height="1.4"/><rect y="11.2" width="20" height="1.4"/></g><rect width="8" height="7.6" fill="#3c3b6e"/></svg>
        </button>
        <button class="lang-btn" data-lang="es" aria-label="Español" aria-pressed="<%= (typeof lang !== 'undefined' && lang === 'es') ? 'true' : 'false' %>">
          <svg class="flag" viewBox="0 0 20 14"><rect width="20" height="14" fill="#aa151b"/><rect y="3.5" width="20" height="7" fill="#f1bf00"/><rect y="0" width="20" height="3.5" fill="#aa151b"/><rect y="10.5" width="20" height="3.5" fill="#aa151b"/></svg>
        </button>
        <button class="lang-btn" data-lang="fr" aria-label="Français" aria-pressed="<%= (typeof lang !== 'undefined' && lang === 'fr') ? 'true' : 'false' %>">
          <svg class="flag" viewBox="0 0 20 14"><rect width="6.6" height="14" fill="#0055A4"/><rect x="6.6" width="6.8" height="14" fill="#fff"/><rect x="13.4" width="6.6" height="14" fill="#EF4135"/></svg>
        </button>
      </div>

      <% if ((typeof lp === 'undefined' || !lp) || (typeof themeToggle !== 'undefined' && themeToggle)) { %>
      <button id="btn-tema" class="theme-toggle" type="button" aria-label="<%= t('theme.toDark') %>" aria-pressed="false">
        <svg class="ic-sol" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/>
        </svg>
        <svg class="ic-lua" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
        </svg>
      </button>
      <% } %>

      <% if (logado) { %>
        <form method="post" action="<%= _base %>/logout" class="nav-logout">
          <button type="submit" class="btn-outline btn-sm"><%= t('nav.logout') %></button>
        </form>
      <% } else { %>
        <a class="btn-primary btn-sm" href="/login"><%= t('nav.enter') %></a>
      <% } %>
    </div>
  </div>
</header>
<% if (typeof lp !== 'undefined' && lp) { %><main><% } else { %><main class="container"><% } %>
