<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'pt' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'Projeto Profissional' %></title>
  <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css" />
  <link rel="stylesheet" href="/css/main.css" />
</head>
<body id="topo">
<nav class="navbar navbar-expand-lg bg-white border-bottom shadow-sm sticky-top">
  <div class="container-fluid px-3 px-lg-4">
    <a class="navbar-brand fw-bold" href="/">Projeto Profissional</a>
    <div class="d-flex align-items-center gap-2 ms-auto">
      <% if (typeof user !== 'undefined' && user) { %>
        <% var mp = (typeof modo !== 'undefined' && modo && modo !== 'production') ? '/' + modo : ''; %>
        <a class="nav-link d-none d-lg-inline" href="<%= mp %>/board"><%= t('nav.board') %></a>
        <a class="nav-link d-none d-lg-inline" href="<%= mp %>/calendario"><%= t('nav.calendar') %></a>
        <% if (user.role === 'admin') { %><a class="nav-link d-none d-lg-inline" href="<%= mp %>/admin"><%= t('nav.users') %></a><% } %>
        <a class="nav-link d-none d-lg-inline" href="<%= mp %>/perfil"><%= t('nav.profile') %></a>
        <button id="btn-logout" type="button" class="btn btn-outline-secondary btn-sm"><%= t('nav.logout') %></button>
      <% } else { %>
        <a class="btn btn-primary btn-sm" href="/login"><%= t('nav.enter') %></a>
      <% } %>

      <label class="lang-select" title="<%= t('lang.label') %>">
        <span class="visually-hidden"><%= t('lang.label') %></span>
        <select id="lang-switcher" aria-label="<%= t('lang.label') %>" class="form-select form-select-sm w-auto">
          <option value="pt">PT</option>
          <option value="en">EN</option>
          <option value="es">ES</option>
          <option value="fr">FR</option>
        </select>
      </label>
      <button id="theme-toggle" type="button" class="btn btn-light btn-sm" aria-label="<%= t('theme.toDark') %>" aria-pressed="false">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"></path></svg>
      </button>
    </div>
  </div>
</nav>
<main>
