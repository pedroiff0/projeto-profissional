<%- include('partials/header', { title: t('nav.board') }) %>
<div class="page-wrap">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="h3 mb-0"><%= t('nav.board') %></h1>
    <button id="btn-new" class="btn-pp btn-pp--primary" type="button"><%= t('task.new') %></button>
  </div>

  <form id="form-task" class="glass p-3 mb-4" hidden>
    <div class="row g-2">
      <input id="f-title" name="title" type="text" maxlength="140" required class="input-pp form-control" placeholder="<%= t('task.title') %>" aria-label="<%= t('task.title') %>" />
      <input id="f-due" name="dueDate" type="date" class="input-pp form-control" aria-label="<%= t('task.dueDate') %>" />
      <select id="f-status" name="status" class="input-pp form-control" aria-label="<%= t('task.status') %>">
        <option value="todo"><%= t('task.todo') %></option>
        <option value="doing"><%= t('task.doing') %></option>
        <option value="done"><%= t('task.done') %></option>
      </select>
      <select id="f-dificuldade" name="dificuldade" class="input-pp form-control" aria-label="Dificuldade">
        <option value="">Dificuldade (opcional)</option>
        <option value="1">1</option>
        <option value="2">2</option>
        <option value="3">3</option>
        <option value="5">5</option>
        <option value="8">8</option>
        <option value="13">13</option>
        <option value="21">21</option>
      </select>
      <button class="btn-pp btn-pp--primary" type="submit"><%= t('task.new') %></button>
      <button id="btn-cancel" class="btn-pp btn-pp--ghost" type="button"><%= t('task.moveLeft') %></button>
    </div>
    <textarea id="f-desc" name="description" maxlength="2000" rows="2" class="input-pp form-control mt-2" placeholder="<%= t('task.description') %>" aria-label="<%= t('task.description') %>"></textarea>
  </form>

  <section class="board" id="board" data-api-base="<%= apiBase %>" aria-live="polite">
    <% statusCatalog.forEach(function(col) { %>
      <div class="board-col" data-status="<%= col.id %>">
        <h2 class="board-col-title"><%= col.label %></h2>
        <div class="board-col-body" data-col="<%= col.id %>"></div>
      </div>
    <% }); %>
  </section>

  <p id="board-status" class="text-muted small mt-2" aria-live="polite"></p>
</div>
<%- include('partials/footer') %>
