<%- include('partials/header', { title: 'Recuperar senha' }) %>
<section class="card auth-card">
  <h1>Recuperar senha</h1>
  <div id="error" class="alert alert-error" hidden></div>
  <div id="ok" class="alert alert-ok" hidden></div>
  <form id="form-forgot" novalidate>
    <label class="field">
      <span>E-mail</span>
      <input id="email" type="email" autocomplete="email" required />
    </label>
    <button type="submit" class="btn-primary btn-block">Enviar link</button>
  </form>
</section>
<%- include('partials/footer', { pageScript: 'forgot-password' }) %>
